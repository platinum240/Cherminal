<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>limited</key>
    <true/>
    <key>allowed_transports</key>
    <array>
        <string>telnet</string>
        <string>ssh</string>
    </array>
    <key>require_tls</key>
    <true/>
    <key>print_to_file</key>
    <false/>
    <key>max_idle_timeout</key>
    <integer>15</integer>
    <key>audit_log</key>
    <true/>
</dict>
</plist>
