# Cherminal site policy. Copy to /etc/cherminal/policy.toml (owned by root,
# readable by everyone) and keep only the lines you need. Every setting is
# optional; leaving one out keeps Cherminal's normal behaviour.
#
# Check a file before deploying it:   cherminal --check-policy policy.toml
# A policy file with a mistake in it stops Cherminal from starting, so a
# typo can never leave clients running without the restrictions.

# Always run in limited mode, as if started with --limited: the File menu
# offers only Close tab and Exit, and users can't edit sessions, make new
# connections, open a local shell, pick files to upload or print to a file.
# limited = true

# The kinds of connection users may open: ssh, telnet, serial, local.
# allowed_transports = ["telnet", "ssh"]

# SFTP upload (drag and drop) even in sessions that turn it on.
# file_upload = false

# Print screen to a PDF file instead of a printer.
# print_to_file = false

# Telnet and TN3270 only over TLS. Off by default: some mainframes don't offer it.
# require_tls = false

# TLS sessions must check the host's certificate (users can't untick
# "Check the host's certificate"). Off by default.
# require_tls_verify = false

# Extra CA certificates (PEM) to trust for TLS, such as an in-house CA that
# signs the mainframes' certificates, so checking can stay on.
# tls_ca_file = "/etc/cherminal/ca.pem"

# Disconnect sessions after this many minutes without typing or clicking.
# Sessions may use a shorter time, but not a longer one or none. Without
# this, each session decides (15 minutes unless changed).
# max_idle_timeout = 15

# Let sessions reconnect by themselves after a dropped connection.
# auto_reconnect = false

# Session logs: "allowed" (each session decides; off unless turned on),
# "never", or "always" (every session is logged).
# session_logging = "allowed"

# Where session logs go. %u is replaced with the user name. Default:
# ~/.local/state/cherminal/logs
# log_dir = "/var/log/cherminal/%u"

# All session logs together are kept under this many MB; the oldest files
# are deleted first.
# log_total_mb = 10

# Write a line to syslog/journald for each connection, disconnection and
# failed connection: user, session, host, what happened and how long it
# lasted. Never anything typed or shown in a session.
# audit_log = true
